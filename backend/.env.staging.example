NODE_ENV=staging
PORT=3000

# Managed PostgreSQL for staging. Never commit the real credential.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require

# Generate independent staging secrets. Never reuse production values.
JWT_SECRET=replace-with-a-long-random-staging-secret
MFA_ENCRYPTION_KEY=replace-with-32-byte-key-encoded-as-base64
MFA_ISSUER=Universal Pet Health Record Staging

# Public URLs for the staging clients/API.
APP_PUBLIC_URL=https://staging.example.com
CORS_ORIGINS=https://staging.example.com

# Email provider. Prefer a sandbox/test domain in staging.
EMAIL_PROVIDER_API_URL=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=noreply-staging@example.com

# Private S3-compatible bucket dedicated to staging.
S3_BUCKET=petrecord-clinical-staging
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
